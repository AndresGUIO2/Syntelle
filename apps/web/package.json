{
  "name": "@syntelle/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:player": "npm run typecheck && vite build --mode stream-player",
    "build:demo:baseline": "npm run typecheck && vite build --mode demo-baseline",
    "build:demo:protected": "npm run typecheck && vite build --mode demo-protected",
    "preview:demo:baseline": "vite preview --mode demo-baseline",
    "preview:demo:protected": "vite preview --mode demo-protected",
    "test:demo:build": "node --test tests/build/demo-build.test.ts",
    "review:demo": "node scripts/review-protected-demo.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts tests config *.ts *.js",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"config/**/*.ts\" \"*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"config/**/*.ts\" \"*.{ts,js}\""
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "pinia": "4.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "javascript-obfuscator": "5.9.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
