# Local development only. Never put provider credentials in VITE_* variables.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
SYNTELLE_CHAT_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-3.8-flash
SYNTELLE_SPEECH_TRIAL=0
SYNTELLE_LOCAL_OWNER=0
# Optional local accounts and private rendered-stream candidate.
SYNTELLE_ACCOUNTS=0
SYNTELLE_STREAMING=0
SYNTELLE_APP_ORIGIN=http://127.0.0.1:5173
SYNTELLE_AUTH_SECRET=
SYNTELLE_RENDER_WORKER_TOKEN=
SYNTELLE_RENDER_CAPACITY=2
# Streaming admission per API process; separate from speech/model usage quotas.
SYNTELLE_STREAM_REQUESTS_PER_MINUTE=600
SYNTELLE_STREAM_IP_REQUESTS_PER_MINUTE=3000
SYNTELLE_STREAM_CONNECTIONS_PER_MINUTE=30
SYNTELLE_STREAM_CONNECTIONS_PER_IP=8
SYNTELLE_STREAM_CONNECTIONS_PER_PRINCIPAL=2
SYNTELLE_STREAM_SESSIONS_PER_PRINCIPAL=1
# Local development allows multiple tabs; production defaults to true when omitted.
SYNTELLE_STREAM_SESSION_LIMIT_ENABLED=false
# Local time caps are disabled; an omitted server setting enables production caps.
SYNTELLE_STREAM_TIME_LIMITS_ENABLED=false
# Empty means ignore forwarded IP headers. Configure only known ingress CIDRs.
SYNTELLE_STREAM_TRUSTED_PROXY_CIDRS=
SYNTELLE_PACKAGE_HASH=
RESEND_API_KEY=
RESEND_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Local PostgreSQL preparation archive. Keep real passwords in .env only.
SYNTELLE_DB_PASSWORD=
SYNTELLE_DATABASE_URL=postgresql://syntelle:YOUR_LOCAL_PASSWORD@127.0.0.1:5433/syntelle
